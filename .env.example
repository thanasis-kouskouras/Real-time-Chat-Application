# EASYTALK ENVIRONMENT CONFIGURATION — EXAMPLE FILE

# Copy this to .env and fill in your values
# Never commit .env to git

# Application
APP_DEBUG=false

# Database
DB_HOST=127.0.0.1
DB_USERNAME=
DB_PASSWORD=
DB_NAME=app_database
DB_PORT=3306

# Email (Gmail App Password — generate at myaccount.google.com > Security > App passwords)
MAIL_USERNAME=
MAIL_PASSWORD=

# Privacy contact email (shown publicly in the Privacy Policy — use a dedicated alias for security reasons, not MAIL_USERNAME)
PRIVACY_EMAIL=

# JWT Secret (generate a strong random string — e.g. openssl rand -base64 64)
JWT_SECRET=

# Encryption key for AES-256-GCM message encryption (generate a strong random string)
ENCRYPTION_KEY=

# WebSocket Server
WS_HOST=
WS_SERVER_PORT=
WS_SERVER_API_KEY=

# Allowed origins for WebSocket Connections (defaults to localhost — set your production domain here)
WS_ALLOWED_ORIGINS=localhost,127.0.0.1

# Application path (must match the folder name under your web server's document root — e.g. if your project lives at http://localhost/my-app/, set APP_PATH=/my-app)
APP_PATH=

# Email SMTP (defaults to Gmail STARTTLS — change if using another provider)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls

